{
  "sheet_id": "kismet",
  "title": "Kismet Wireless",
  "source": "https://offensiveramen.com/cheatsheets/kismet",
  "default_file": "profiles/kismet.txt",
  "categories": [
    "Installation",
    "Starting Kismet",
    "Capture Sources",
    "Source Options",
    "Rest Api",
    "Logging",
    "Wardrive Mode"
  ],
  "commands": [
    {
      "switch": "apt install",
      "template": "sudo apt install kismet",
      "description": "Kali/Debian",
      "category": "Installation"
    },
    {
      "switch": "usermod +kismet",
      "template": "sudo usermod -aG kismet $USER",
      "description": "Add user to kismet group (avoids running as root)",
      "category": "Installation"
    },
    {
      "switch": "kismet",
      "template": "kismet",
      "description": "Start with auto-detected source",
      "category": "Starting Kismet"
    },
    {
      "switch": "-c (Specify WiFi source)",
      "template": "kismet -c <interface>",
      "description": "Specify WiFi source",
      "category": "Starting Kismet"
    },
    {
      "switch": "-c (Channels)",
      "template": "kismet -c <interface>:name=<source_name>,hop=true,channels=\"<channels>\"",
      "description": "Specify source with options",
      "category": "Starting Kismet"
    },
    {
      "switch": "-c (Multiple sources)",
      "template": "kismet -c <interface> -c <interface>",
      "description": "Multiple sources",
      "category": "Starting Kismet"
    },
    {
      "switch": "--daemonize",
      "template": "kismet --daemonize",
      "description": "Start as daemon",
      "category": "Starting Kismet"
    },
    {
      "switch": "-c (WiFi)",
      "template": "kismet -c <interface>",
      "description": "WiFi",
      "category": "Capture Sources"
    },
    {
      "switch": "-c (Monitor mode)",
      "template": "kismet -c <monitor_interface>",
      "description": "Monitor mode",
      "category": "Capture Sources"
    },
    {
      "switch": "-c (Bluetooth)",
      "template": "kismet -c <hci_interface>:type=linuxbluetooth",
      "description": "Bluetooth",
      "category": "Capture Sources"
    },
    {
      "switch": "-c (RTL433 SDR)",
      "template": "kismet -c <sdr_device>:type=rtl433",
      "description": "RTL-SDR (Software Defined Radio)",
      "category": "Capture Sources"
    },
    {
      "switch": "-c (ADS-B)",
      "template": "kismet -c <sdr_device>:type=rtladsb",
      "description": "ADS-B aircraft",
      "category": "Capture Sources"
    },
    {
      "switch": "Remote Sensor",
      "template": "kismet_cap_linux_wifi --connect <remote_host>:3501 --source <interface>",
      "description": "Remote capture (distributed)",
      "category": "Capture Sources"
    },
    {
      "switch": "-c (Hop: ON)",
      "template": "kismet -c <interface>:hop=true",
      "description": "Channel hopping",
      "category": "Source Options"
    },
    {
      "switch": "-c (Lock Chan)",
      "template": "kismet -c <interface>:hop=false,channel=<channel>",
      "description": "Lock to channel 6",
      "category": "Source Options"
    },
    {
      "switch": "-c (Channels)",
      "template": "kismet -c <interface>:channels=\"<channels>\"",
      "description": "Specific channels",
      "category": "Source Options"
    },
    {
      "switch": "-c (Hop Rate)",
      "template": "kismet -c <interface>:hoprate=<hops_per_sec>",
      "description": "Hops per second",
      "category": "Source Options"
    },
    {
      "switch": "-c (Band: 2.4GHz)",
      "template": "kismet -c <interface>:band=2.4GHz",
      "description": "Band selection",
      "category": "Source Options"
    },
    {
      "switch": "-c (Band: 5GHz)",
      "template": "kismet -c <interface>:band=5GHz",
      "description": "Stop capture automatically after receiving count packets",
      "category": "Source Options"
    },
    {
      "switch": "API: status.json",
      "template": "curl http://<host>:2501/system/status.json  -H \"KISMET: admin:password\"",
      "description": "Get system status",
      "category": "Rest Api"
    },
    {
      "switch": "API: List devices",
      "template": "curl http://<host>:2501/devices/all_devices.json  -H \"KISMET: admin:password\"",
      "description": "List devices",
      "category": "Rest Api"
    },
    {
      "switch": "API: devices.json",
      "template": "curl -X POST http://<host>:2501/devices/summary/devices.json  -H \"KISMET: admin:password\"  -d '{\"fields\":[\"kismet.device.base.name\",\"kismet.device.base.macaddr\"]}'",
      "description": "Filter devices",
      "category": "Rest Api"
    },
    {
      "switch": "API: devices.json",
      "template": "curl http://<host>:2501/devices/by-mac/<mac_address>/devices.json  -H \"KISMET: admin:password\"",
      "description": "Get specific device",
      "category": "Rest Api"
    },
    {
      "switch": "API: <output_pcap>",
      "template": "curl http://<host>:2501/datasource/by-uuid/<uuid>/pcap/<output_pcap>  -H \"KISMET: admin:password\" -o <output_pcap>",
      "description": "Download PCAP",
      "category": "Rest Api"
    },
    {
      "switch": "DB -> PCAP",
      "template": "kismetdb_to_pcap --in <kismet_db> --out <output_pcap>",
      "description": "Convert to other formats",
      "category": "Logging"
    },
    {
      "switch": "DB -> WIGLECSV",
      "template": "kismetdb_to_wiglecsv --in <kismet_db> --out <output_csv>",
      "description": "Convert .kismet database log to WiGLE.net upload CSV format",
      "category": "Logging"
    },
    {
      "switch": "DB -> KML",
      "template": "kismetdb_to_kml --in <kismet_db> --out <output_kml>",
      "description": "Export captured geolocation coordinates to Google Earth KML map",
      "category": "Logging"
    },
    {
      "switch": "--log-types",
      "template": "kismet -c <interface> --log-types pcapng,kismet",
      "description": "Log types",
      "category": "Logging"
    },
    {
      "switch": "--log-prefix",
      "template": "kismet -c <interface> --log-prefix mylog",
      "description": "Custom prefix",
      "category": "Logging"
    },
    {
      "switch": "Wardrive Mode",
      "template": "kismet -c <interface> --override wardrive",
      "description": "Combine with GPS for wardriving",
      "category": "Wardrive Mode"
    },
    {
      "switch": "gpsd",
      "template": "gpsd",
      "description": "GPS sources",
      "category": "Wardrive Mode"
    },
    {
      "switch": "GPS (Serial)",
      "template": "kismet -c <interface> --gps serial:<gps_device_path>",
      "description": "Serial GPS",
      "category": "Wardrive Mode"
    },
    {
      "switch": "GPS (gpsd)",
      "template": "kismet -c <interface> --gps gpsd:host=localhost,port=2947",
      "description": "Stop capture automatically after receiving count packets",
      "category": "Wardrive Mode"
    },
    {
      "switch": "DB -> WIGLECSV",
      "template": "kismetdb_to_wiglecsv --in <kismet_db> --out <output_csv>",
      "description": "Upload results to WiGLE.net",
      "category": "Wardrive Mode"
    }
  ],
  "reference_notes": [
    "[\ud83c\udf36 Kismet] Wireless network detector, sniffer, and IDS. Supports WiFi,",
    "[\ud83c\udf36 Kismet] Bluetooth, SDR, and other wireless protocols.",
    "[Web Ui Features] Live device count, packet rates, alerts",
    "[Web Ui Features] GPS mapping (if GPS connected)",
    "[Web Ui Features] Channel activity graph",
    "[Web Ui Features] All discovered wireless devices",
    "[Web Ui Features] Filter by type (AP, client, bridged, etc.)",
    "[Web Ui Features] Sort by signal strength, packets, time",
    "[Web Ui Features] Click device for details",
    "[Web Ui Features] BSSID, ESSID, encryption type",
    "[Web Ui Features] Channel, frequency, signal strength",
    "[Web Ui Features] Connected clients",
    "[Web Ui Features] Packet counts and data rates",
    "[Web Ui Features] Manufacturer (OUI lookup)",
    "[Web Ui Features] GPS location (if available)",
    "[Web Ui Features] Rogue AP detection",
    "[Web Ui Features] Deauth flood detection",
    "[Web Ui Features] BSSID spoofing",
    "[Web Ui Features] Channel hopping anomalies",
    "[Detection / Ids] New/unknown APs on network",
    "[Detection / Ids] Deauthentication floods",
    "[Detection / Ids] BSSID spoofing / evil twin APs",
    "[Detection / Ids] Probe request tracking",
    "[Detection / Ids] Channel hopping anomalies",
    "[Detection / Ids] Unusual client behavior",
    "[Detection / Ids] WPS attacks",
    "[Detection / Ids] KARMA attacks",
    "[Tips] Web UI at port 2501 is the primary interface",
    "[Tips] Add user to kismet group to avoid running as root",
    "[Tips] .kismet files are SQLite \u2014 query with standard SQL tools",
    "[Tips] Use multiple WiFi adapters for better coverage",
    "[Tips] Channel locking is better for targeted capture",
    "[Tips] GPS integration enables wardrive mapping",
    "[Tips] REST API allows integration with custom tools",
    "[Tips] Supports remote capture for distributed sensing",
    "[Tips] Kismet can detect rogue APs and evil twins",
    "[Tips] Export to PCAP for detailed analysis in Wireshark"
  ]
}