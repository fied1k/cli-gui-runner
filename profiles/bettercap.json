    "[Proxy Scripts (Javascript)] // Inject content into HTTP responses",
    "[Proxy Scripts (Javascript)] function onResponse(req, res) {",
    "[Proxy Scripts (Javascript)] if (res.ContentType.indexOf('text/html') == 0) {",
    "[Proxy Scripts (Javascript)] var body = res.ReadBody();",
    "[Proxy Scripts (Javascript)] res.Body = body.replace('</head>',",
    "[Proxy Scripts (Javascript)] '<script>alert(\"injected\")</script></head>');",
    "[Proxy Scripts (Javascript)] }",
    "[Proxy Scripts (Javascript)] }",
    "[Proxy Scripts (Javascript)] // Log POST data",
    "[Proxy Scripts (Javascript)] function onRequest(req, res) {",
    "[Proxy Scripts (Javascript)] if (req.Method == \"POST\") {",
    "[Proxy Scripts (Javascript)] log(\"POST \" + req.Hostname + req.Path +",
    "[Proxy Scripts (Javascript)] \" | Body: \" + req.ReadBody());",
    "[Proxy Scripts (Javascript)] }",
    "[Proxy Scripts (Javascript)] }",
